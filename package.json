{
  "name": "crowdsurf",
  "version": "0.2.0",
  "description": "A crew of cursors builds part or all of your web page in front of the reader as they scroll.",
  "keywords": [
    "scroll",
    "animation",
    "cursor",
    "reveal",
    "typing",
    "intersection-observer"
  ],
  "homepage": "https://jugglingjon.github.io/crowdsurf/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jugglingjon/crowdsurf.git"
  },
  "bugs": "https://github.com/jugglingjon/crowdsurf/issues",
  "license": "MIT",
  "type": "module",
  "main": "./dist/crowdsurf.js",
  "module": "./dist/crowdsurf.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/crowdsurf.global.min.js",
  "jsdelivr": "./dist/crowdsurf.global.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/crowdsurf.js"
    },
    "./auto": "./dist/crowdsurf.auto.js",
    "./prehide.css": "./dist/prehide.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "docs"
  ],
  "sideEffects": [
    "./dist/crowdsurf.auto.js",
    "./dist/*.min.js",
    "./src/auto.js",
    "./src/global.js",
    "./src/global-auto.js",
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.cjs",
    "serve": "python3 -m http.server 4173",
    "pretest": "npm run build",
    "test": "node test/smoke.cjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "playwright": "^1.48.0"
  }
}
